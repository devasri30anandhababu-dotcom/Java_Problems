import java.util.*;

public class Main {
    static int sum(int[][] arr, int r, int c) {
        int s = 0;
        for(int i = 0; i < r; i++) {
            for(int j = 0; j < c; j++) {
                s += arr[i][j];
            }
        }
        return s;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int r = sc.nextInt();
        int c = sc.nextInt();

        int[][] arr = new int[r][c];
        for(int i=0;i<r;i++)
            for(int j=0;j<c;j++)
                arr[i][j] = sc.nextInt();

        System.out.println("Sum = " + sum(arr, r, c));
    }
}
