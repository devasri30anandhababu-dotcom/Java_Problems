
import java.util.Scanner;

public class PrimeCheck {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();

        int i = 1, count = 0;

        while(i <= num){
            if(num % i == 0){
                count++;
            }
            i++;
        }

        if(count == 2){
            System.out.println("Prime Number");
        } else {
            System.out.println("Not Prime");
        }
    }
}
